{
  "architectures": [
    "Glm5MoeForCausalLM"
  ],
  "provenance": "结构照 GLM-4.5 / GLM-4.6 的公开 config 填，GLM-5.0 的官方数还没有。拿到真的 config.json 换掉这一份即可，glm.py 不用动。",
  "attention_bias": true,
  "attention_dropout": 0.0,
  "eos_token_id": 151329,
  "expert_dtype": "fp4",
  "first_k_dense_replace": 3,
  "head_dim": 128,
  "hidden_act": "silu",
  "hidden_size": 5120,
  "initializer_range": 0.02,
  "intermediate_size": 12288,
  "max_position_embeddings": 202752,
  "model_type": "glm5_moe",
  "moe_intermediate_size": 1536,
  "n_group": 1,
  "n_routed_experts": 160,
  "n_shared_experts": 1,
  "norm_topk_prob": true,
  "num_attention_heads": 96,
  "num_experts_per_tok": 8,
  "num_hidden_layers": 92,
  "num_key_value_heads": 8,
  "num_nextn_predict_layers": 1,
  "partial_rotary_factor": 0.5,
  "quantization_config": {
    "activation_scheme": "dynamic",
    "fmt": "e4m3",
    "quant_method": "fp8",
    "weight_block_size": [
      128,
      128
    ]
  },
  "rms_norm_eps": 1e-05,
  "rope_theta": 1000000,
  "routed_scaling_factor": 1.0,
  "scoring_func": "sigmoid",
  "swiglu_limit": 0.0,
  "tie_word_embeddings": false,
  "topk_group": 1,
  "topk_method": "noaux_tc",
  "torch_dtype": "bfloat16",
  "use_qk_norm": true,
  "vocab_size": 151552
}
